HOST=127.0.0.1
PORT=3000
ART_VINT_DB=data/artvint.sqlite
# Wymagane przy uruchomieniu za publicznym proxy HTTPS.
# ART_VINT_ORIGIN=https://artvint.example.com

# Podaj oba ustawienia, aby utworzyć pierwsze konto @admin.
# ART_VINT_ADMIN_EMAIL=admin@example.com
# ART_VINT_ADMIN_PASSWORD=

# Gmail z hasłem aplikacji.
# ART_VINT_SMTP_HOST=smtp.gmail.com
# ART_VINT_SMTP_PORT=465
# ART_VINT_SMTP_USER=
# ART_VINT_SMTP_PASSWORD=
# ART_VINT_MAIL_FROM="ArtVint <noreply@example.com>"

# Alternatywnie ustaw URL SMTP i nadawcę. Zakoduj znaki specjalne w danych logowania.
# ART_VINT_SMTP_URL=smtps://login:haslo@smtp.example.com:465

# Klucz do usługi Pickup Services MyPudo wydany przez DPD Polska.
# ART_VINT_DPD_API_KEY=
